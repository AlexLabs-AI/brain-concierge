# GBrain connection
GBRAIN_URL=http://localhost:7350
GBRAIN_TOKEN=your-gbrain-bearer-token

# Concierge server
PORT=7351
CONCIERGE_TOKEN=generate-a-secure-random-token

# LLM for synthesis
# Sonnet is the default — override with claude-haiku-4-5 for cost-sensitive deployments
ANTHROPIC_API_KEY=your-anthropic-api-key
SYNTHESIS_MODEL=claude-sonnet-4-6
